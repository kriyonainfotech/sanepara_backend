PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/sanepara_crm
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the first Super Admin
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sanepara.com
SEED_ADMIN_PASSWORD=Admin@123

# WhatsApp (optional). Without a provider, reminders open a wa.me click-to-send link.
# Option 1: InstantBroadcast (api.instantbroadcast.in)
WHATSAPP_PROVIDER=
INSTANTBROADCAST_TOKEN=

# Option 2: WhatsApp Cloud API (Meta) - leave WHATSAPP_PROVIDER empty
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# For both options:
# Approved template for business-initiated messages, body params: {{1}} name, {{2}} bills, {{3}} month
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
